@startuml
!include _style.iuml
title EduConnect - Use Case Diagram
left to right direction
actor Student as S
actor Tutor as T
actor "Administrator" as A

rectangle "EduConnect System" {
  usecase "UC1 Register / Log in" as UC1
  usecase "UC2 Manage Profile" as UC2
  usecase "UC3 Submit Tutoring\nRequirements" as UC3
  usecase "UC4 View Ranked\nTutor Matches" as UC4
  usecase "UC5 View Compatibility\nExplanation" as UC5
  usecase "UC6 Check Tutor\nAvailability" as UC6
  usecase "UC7 Book Session" as UC7
  usecase "UC8 Prevent Booking\nConflict" as UC8
  usecase "UC9 Track Booking Status" as UC9
  usecase "UC10 Cancel Booking" as UC10
  usecase "UC11 Manage Availability\nSlots" as UC11
  usecase "UC12 Confirm / Complete\nBooking" as UC12
  usecase "UC13 Verify Tutor Profiles" as UC13
  usecase "UC14 Manage Subjects" as UC14
}

S --> UC1
S --> UC2
S --> UC3
S --> UC4
S --> UC7
S --> UC9
T --> UC1
T --> UC2
T --> UC11
T --> UC12
A --> UC13
A --> UC14
UC10 --> S

UC4 ..> UC3 : <<include>>
UC4 ..> UC5 : <<include>>
UC4 ..> UC6 : <<include>>
UC7 ..> UC8 : <<include>>
UC10 ..> UC9 : <<extend>>
note bottom of UC8
  Rejects a booking when the slot is taken
  or the student/tutor already has an
  overlapping active booking.
end note
@enduml
