  DiamondBorderColor #B7791F
}
skinparam object {
  BackgroundColor #F4F8FC
  BorderColor #1F4E79
}
skinparam entity {
  BackgroundColor #F4F8FC
  BorderColor #1F4E79
}
skinparam note {
